    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleDialogue.Array.data[0].transcription
      value: Clean my mission is to clean.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleDialogue.Array.data[1].transcription
      value: I clean the floors, to clean the floors is what I do.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleDialogue.Array.data[2].transcription
      value: Did you know a mop makes a fashionable wig?
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191353].taskPerformSound.AssetReference.m_AssetGUID
