    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191353].stateExitDialogue.Array.data[0].transcription
      value: So filthy, so very filthy.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191353].stateExitDialogue.Array.data[1].transcription
      value: A clean floor is a clean mind.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191353].stateExitDialogue.Array.data[2].transcription
      value: What a pig sty.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191353].stateExitDialogue.Array.data[3].transcription
      value: Did your mother teach you this?
      objectReference: {fileID: 0}
