        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleEmaggedDialogue.Array.data[0].transcription
      value: I clean the floors, but who will clean away your sins?
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleEmaggedDialogue.Array.data[1].transcription
      value: To watch them slip is what brings me joy.
      objectReference: {fileID: 0}
    - target: {fileID: 4923876028853451434, guid: b6b606388cb517144a21d93415c57401,
        type: 3}
      propertyPath: managedReferences[5041995600707191352].idleEmaggedDialogue.Array.data[2].transcription
      value: Cleaning tip of the day; To keep your insides clean, remember to drink
        bleach!
      objectReference: {fileID: 0}
