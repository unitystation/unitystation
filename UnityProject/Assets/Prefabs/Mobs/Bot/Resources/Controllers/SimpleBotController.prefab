        type: 3}
      propertyPath: managedReferences[5041995600707191345].idleDialogue.Array.data[0].transcription
      value: Be done with your passion projects.
      objectReference: {fileID: 0}
    - target: {fileID: 3018758427664923401, guid: 221b6b5f05c64124cb6bab0dbfc5f103,
        type: 3}
      propertyPath: managedReferences[5041995600707191345].idleDialogue.Array.data[1].transcription
      value: All in all its just another brick in the wall
      objectReference: {fileID: 0}
    - target: {fileID: 3018758427664923401, guid: 221b6b5f05c64124cb6bab0dbfc5f103,
        type: 3}
      propertyPath: managedReferences[5041995600707191345].idleDialogue.Array.data[2].transcription
      value: Please stop destroying this station, I can't anymore... I can't.
      objectReference: {fileID: 0}
    - target: {fileID: 3018758427664923401, guid: 221b6b5f05c64124cb6bab0dbfc5f103,
        type: 3}
      propertyPath: managedReferences[5041995600707191345].idleDialogue.Array.data[3].transcription
      value: If only I got paid for this.
      objectReference: {fileID: 0}
