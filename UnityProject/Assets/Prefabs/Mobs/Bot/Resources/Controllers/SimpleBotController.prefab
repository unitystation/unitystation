      propertyPath: managedReferences[5041995600707191346].stateExitDialogue.Array.data[0].transcription
      value: Why must I fix everything I touch?
      objectReference: {fileID: 0}
    - target: {fileID: 3018758427664923401, guid: 221b6b5f05c64124cb6bab0dbfc5f103,
        type: 3}
      propertyPath: managedReferences[5041995600707191346].stateExitDialogue.Array.data[1].transcription
      value: Patching holes. But who is going to patch the hole in my heart?
      objectReference: {fileID: 0}
