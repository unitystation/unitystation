      propertyPath: managedReferences[5041995600707191346].stateExitDialogue.Array.data[3].transcription
      value: Witness the purity of entropy.
      objectReference: {fileID: 0}
    - target: {fileID: 3018758427664923401, guid: 221b6b5f05c64124cb6bab0dbfc5f103,
        type: 3}
      propertyPath: managedReferences[5041995600707191346].stateExitDialogue.Array.data[4].transcription
